# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/data/*
# Datová linka: fronta úloh patří do gitu, pracovní soubory a oznámení ne.
!/data/linka/
/data/linka/prace/
/data/linka/oznameni/
!/data/transit_graph.json
!/data/school_locations.json
!/data/inspection_extractions.json
!/data/inspis_school_profiles.json
!/data/inspis_coverage_summary.json
!/data/csi_manifest.json
!/data/csi_diff_latest.json
!/data/city_narratives.json
!/data/csi_snapshots/
!/data/csi_snapshots/*.json
!/data/msmt_rejstrik/
!/data/msmt_rejstrik/README.md
!/data/msmt_rejstrik/nazvy-oboru.json

# Portál pro školy: hashe kódů patří do gitu, plaintext kódy nikdy
!/data/portal/
/data/portal/kody-plaintext.json

# TT Decoder outputs (large binary/generated files)
/data/decoded_tt*/
/data/gtfs_from_tt*/
/data/KOMPLET_decoded/
/data/GTFS_CZ/
*.json.log
/logs/
tt_decoder_*.log

/.playwright-mcp
__pycache__/

# Lokální snímky rejstříku MŠMT (velké soubory, zdroj a postup v data/msmt_rejstrik/README.md)
data/msmt_rejstrik/*.jsonld
.claude/worktrees/

# Vygenerované zprávy odběru: vznikají skriptem scripts/novinky.py a schvalují
# se samostatným pull requestem, ne spolu s kódem odběru.
public/novinky/
/data/portal/pilot-kontakty.json
