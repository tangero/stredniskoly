{
  "name": "gymnazium-next",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-sitemap.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "python3 -m unittest discover -s tests",
    "kontroly": "python3 scripts/stav-datovych-sad.py kontrola && python3 scripts/kontrola-letopoctu.py && npx tsc --noEmit",
    "update:csi": "node scripts/process-csi-data.js",
    "inspis:build-data": "node scripts/import-inspis-data.js",
    "sitemap:build": "node scripts/generate-sitemap.mjs",
    "test:novinky": "node --experimental-strip-types --test tests/novinky-*.test.mjs",
    "novinky:migrace": "node scripts/novinky-migrace.mjs",
    "novinky:migrace-kontrola": "node scripts/novinky-migrace.mjs --kontrola",
    "portal:export": "node --experimental-strip-types scripts/portal-export.mjs",
    "portal:export-kontrola": "node --experimental-strip-types scripts/portal-export.mjs --kontrola",
    "test:js": "node --experimental-strip-types --test 'tests/!(mesto-prehled|vyhledavani-mesta|veletrhy|veletrhy-nahlasit|veletrhy-render).test.mjs'",
    "test:mesto": "npx --yes tsx --test tests/mesto-prehled.test.mjs tests/vyhledavani-mesta.test.mjs tests/veletrhy.test.mjs tests/veletrhy-nahlasit.test.mjs tests/veletrhy-render.test.mjs",
    "test:integrace": "node --experimental-strip-types --test tests/catalog-2026.integration.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/analytics": "^1.6.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "16.1.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  }
}
